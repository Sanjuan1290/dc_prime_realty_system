# APPLICATION
NODE_ENV=development
HR_STAGING_ONLY=true

# CORS
HR_CORS_ORIGIN=https://dc-prime-realty.pages.dev

# DATABASE — TiDB
HR_DB_HOST=YOUR_TIDB_HOST
HR_DB_PORT=4000
HR_DB_USER=YOUR_TIDB_USERNAME
HR_DB_PASSWORD=YOUR_TIDB_PASSWORD
HR_DB_NAME=dc_prime_hr_db
HR_DB_TLS=true

# AUTHENTICATION
HR_JWT_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
HR_COOKIE_SECURE=true

# HR OPERATIONS — DISABLED FOR INITIAL TESTING
HR_ENABLE_WRITES=false
HR_ENABLE_JOBS=false

# PAYROLL INTEGRATION
HR_ALLOW_PAYROLL_RELEASE=false
HR_ENABLE_SALARY_DELIVERY=false

# ATTENDANCE KIOSK
ATTENDANCE_PINCODE=
ATTENDANCE_KIOSK_SECRET=