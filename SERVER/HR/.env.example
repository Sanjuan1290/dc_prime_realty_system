# APPLICATION
NODE_ENV=production
HR_READ_ONLY=false

# CORS
HR_CORS_ORIGIN=https://dc-prime-realty.pages.dev

# DATABASE — TiDB
HR_DB_HOST=YOUR_TIDB_HOST
HR_DB_PORT=4000
HR_DB_USER=YOUR_TIDB_USERNAME
HR_DB_PASSWORD=YOUR_TIDB_PASSWORD
HR_DB_NAME=dc_prime_hr_db
HR_DB_TLS=true
HR_DB_CONNECT_TIMEOUT_MS=10000
HR_DB_STARTUP_TIMEOUT_MS=30000

# AUTHENTICATION
HR_JWT_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
HR_COOKIE_SECURE=true

# PASSWORD RESET EMAILS (HR service settings)
RESEND_API_KEY=
EMAIL_FROM=
HR_PUBLIC_URL=https://dc-prime-realty.pages.dev/hr/login

# HR OPERATIONS
HR_ENABLE_JOBS=true

# PAYROLL INTEGRATION
HR_ENABLE_SALARY_DELIVERY=true
REALTY_FINANCE_SALARY_ENDPOINT=https://dc-prime-realty-system.onrender.com/api/v1/internal/finance/salary-events
HR_TO_REALTY_INTEGRATION_TOKEN=

# ATTENDANCE KIOSK
ATTENDANCE_PINCODE=
ATTENDANCE_KIOSK_SECRET=
